---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page does not exist.">
  <main class="mx-auto flex w-full max-w-2xl flex-1 flex-col items-center justify-center px-6 py-24">
    <p class="section-label mb-6">404</p>
    <p class="bio-text text-center">This page wandered off.</p>
    <a
      href="/"
      class="font-mono text-[12px] uppercase tracking-[0.15em] text-muted hover:text-body transition-colors"
    >
      Back home
    </a>
  </main>
</Base>
