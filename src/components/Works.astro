---
import { works } from "../content/site";
---

<section id="works" class="mx-auto max-w-2xl px-6 pb-8 pt-4 md:pt-6 md:pb-12">
  <h2 class="section-label mb-[40px]">Works</h2>
  <ul class="grid gap-10 sm:grid-cols-3 sm:gap-6">
    {
      works.map((work) => (
        <li>
          <a href={work.href} class="group block" target="_blank" rel="noreferrer">
            <div class="mb-3 aspect-[4/3] overflow-hidden bg-soft">
              <img
                src={work.image}
                alt=""
                class="h-full w-full object-contain p-3 transition-opacity group-hover:opacity-80"
              />
            </div>
            <h3 class="font-serif text-[17px] text-ink group-hover:text-body transition-colors">
              {work.title}
            </h3>
            <p class="mt-1 font-serif text-[15px] leading-relaxed text-body">{work.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
