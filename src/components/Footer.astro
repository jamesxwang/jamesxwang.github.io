---
import HappyLive from "./HappyLive.astro";
import { site } from "../content/site";

const explore = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: "Resume", href: "/resume/" },
  { label: "RSS", href: "/atom.xml" },
];

const contact = [
  { label: "Email", href: `mailto:${site.email}`, external: false },
  { label: "GitHub", href: site.github, external: true },
  { label: "LinkedIn", href: site.linkedin, external: true },
];

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line px-6 pb-10 pt-10">
  <div class="mx-auto grid max-w-2xl gap-8 sm:grid-cols-3 sm:gap-6">
    <div>
      <h2 class="mb-4 font-mono text-[12px] font-normal uppercase tracking-[0.15em] text-muted">
        Explore
      </h2>
      <ul class="flex list-none flex-col gap-2 p-0">
        {
          explore.map((link) => (
            <li>
              <a href={link.href} class="font-mono text-[12px] text-body transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="mb-4 font-mono text-[12px] font-normal uppercase tracking-[0.15em] text-muted">
        Contact
      </h2>
      <ul class="flex list-none flex-col gap-2 p-0">
        {
          contact.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-[12px] text-body transition-colors hover:text-ink"
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="mb-4 font-mono text-[12px] font-normal uppercase tracking-[0.15em] text-muted">
        Site
      </h2>
      <p class="font-mono text-[11px] tracking-wide text-muted">© {year} {site.name}</p>
      <p class="mt-2 font-serif text-[15px] text-body"><HappyLive /></p>
      <p class="mt-3 font-mono text-[11px] tracking-wide text-muted">
        <span id="busuanzi_container_site_pv">
          PV <span id="busuanzi_value_site_pv"></span>
        </span>
        <span class="mx-2">·</span>
        <span id="busuanzi_container_site_uv">
          UV <span id="busuanzi_value_site_uv"></span>
        </span>
      </p>
    </div>
  </div>
</footer>
