---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
    timeZone: "UTC",
  });
---

<ul class="space-y-5">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
          <time
            datetime={post.data.date.toISOString()}
            class="shrink-0 font-mono text-[12px] tracking-wide text-muted"
          >
            {formatDate(post.data.date)}
          </time>
          <span class="font-serif text-[19px] text-ink transition-colors group-hover:text-body">
            {post.data.title}
          </span>
        </a>
      </li>
    ))
  }
</ul>
