---
import { bio } from "../content/site";
import HappyLive from "./HappyLive.astro";
---

<section class="mx-auto max-w-2xl px-6 pt-8 pb-6 md:pt-12 md:pb-8">
  {
    bio.map((paragraph) => (
      <p class="bio-text" set:html={paragraph.html} />
    ))
  }
  <p class="bio-text last:mb-0"><HappyLive /></p>
</section>
