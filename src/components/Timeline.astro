---
import { timeline } from "../content/site";

const minDotGap = 80;
const sameSideGap = 40;
const labelInset = 18;
const startPad = 120;

const monoWidth = (text: string, size: number) => [...text].length * size * 0.62;

const labelWidth = (item: (typeof timeline)[number]) => {
  const year = monoWidth(item.year, 11);
  const company = "company" in item && item.company ? item.company : "";
  const move = "label" in item && item.label ? item.label : "";
  const role = "role" in item && item.role ? item.role : "";
  const main = item.kind === "work"
    ? monoWidth(company.toUpperCase(), 11) + 16
    : monoWidth((move || company).toUpperCase(), 12);
  return Math.max(year, main, role ? monoWidth(role.toUpperCase(), 12) : 0);
};

let aboveEnd = startPad;
let belowEnd = startPad;
let lastDot = startPad - minDotGap;
let maxRight = startPad;

const isNearBlack = (color?: string) => {
  if (!color?.startsWith("#") || color.length < 7) return false;
  const n = parseInt(color.slice(1, 7), 16);
  const r = (n >> 16) & 255;
  const g = (n >> 8) & 255;
  const b = n & 255;
  return (r + g + b) / 3 < 48;
};

const packed = timeline.map((item) => {
  const below = item.kind !== "work";
  const width = labelWidth(item);
  const left = Math.max(below ? belowEnd : aboveEnd, lastDot + minDotGap);
  lastDot = left;
  const end = left + labelInset + width + sameSideGap;
  if (below) belowEnd = end;
  else aboveEnd = end;
  maxRight = Math.max(maxRight, left + labelInset + width);

  const axis = 150;
  const connectorHeight = item.rise ?? (below ? 36 : 80);
  const dotTop = below ? axis + connectorHeight : axis - connectorHeight;
  const fill = item.colorEnd
    ? `linear-gradient(135deg, ${item.color}, ${item.colorEnd})`
    : item.color;

  return { item, below, left, axis, connectorHeight, dotTop, fill };
});

const arrowLeft = maxRight + 16;
const trackWidth = arrowLeft + 12 + startPad;
---

<section
  class="relative w-full min-w-0"
  aria-label="Career timeline"
  data-timeline
>
  <div
    class="timeline-band relative z-10 flex min-h-[calc(100svh-10rem)] items-center overflow-hidden py-16 md:py-20"
    data-timeline-sticky
  >
    <div class="timeline-grid" aria-hidden="true"></div>
    <div
      class="relative z-10 shrink-0 will-change-transform"
      style={`height: 300px; width: ${trackWidth}px;`}
      data-timeline-track
    >
      <div
        class="absolute bg-muted"
        data-timeline-axis
        style={`top: 150px; left: 0; height: 1px; width: ${arrowLeft}px;`}
      >
      </div>
      <svg
        class="absolute"
        data-timeline-arrow
        style={`top: 145px; left: ${arrowLeft}px;`}
        width="12"
        height="11"
        viewBox="0 0 12 11"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M2 1.5L10 5.5L2 9.5"
          stroke="var(--muted)"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>

      {
        packed.map(({ item, below, left, axis, connectorHeight, dotTop, fill }) => {
          const isEducation = item.kind === "education";

          return (
            <div
              class="absolute top-0 h-full"
              data-timeline-item
              data-side={below ? "below" : "above"}
              style={`left: ${left}px; padding-top: ${dotTop}px;`}
            >
              <div
                class="absolute"
                style={`top: ${below ? axis : dotTop}px; left: 5px; width: 1px; height: ${connectorHeight}px; border-left: 1px dashed var(--muted);`}
              />
              <div
                class:list={["absolute rounded-sm", !below && isNearBlack(item.color) && "timeline-halo"]}
                style={`top: ${dotTop}px; left: 0; transform: translateY(-50%); width: 10px; height: 10px; background: ${below ? "var(--muted)" : fill};`}
              />
              <div
                class="font-timeline -translate-y-1/2 flex flex-col items-start gap-0.5 uppercase"
                data-timeline-label
                style="margin-left: 18px;"
              >
                <span class="text-[11px] tracking-wide text-muted whitespace-nowrap">
                  {item.year}
                </span>
                {isEducation ? (
                  item.href ? (
                    <a
                      href={item.href}
                      class="text-[12px] text-ink whitespace-nowrap underline underline-offset-2 hover:text-body transition-colors"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {item.company}
                    </a>
                  ) : (
                    <span class="text-[12px] text-ink whitespace-nowrap">{item.company}</span>
                  )
                ) : item.kind === "move" ? (
                  <span class="text-[12px] text-muted whitespace-nowrap">{item.label}</span>
                ) : (
                  <span
                    class:list={[
                      "w-fit whitespace-nowrap rounded px-2 py-0.5 text-[11px] font-medium",
                      isNearBlack(item.color) && "timeline-halo",
                    ]}
                    style={`background: ${item.colorEnd ? fill : item.ink ? item.color : `${item.color}cc`}; color: ${item.ink ?? "#000"};`}
                  >
                    {item.company}
                  </span>
                )}
                {item.role && (
                  <span
                    class:list={[
                      "text-[12px] whitespace-nowrap",
                      below ? "text-muted" : "text-body",
                    ]}
                  >
                    {item.role}
                  </span>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  :global(html[data-theme="dark"]) .timeline-halo {
    box-shadow: 0 0 0 1px var(--muted);
  }

  .timeline-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  .timeline-grid::before,
  .timeline-grid::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: color-mix(in oklch, var(--muted) 14%, transparent);
  }

  .timeline-grid::before {
    mask-image:
      repeating-linear-gradient(
        to bottom,
        #000 0 1px,
        transparent 1px 24px
      ),
      repeating-linear-gradient(
        to right,
        #000 0 4px,
        transparent 4px 8px
      );
    mask-composite: intersect;
    -webkit-mask-image:
      repeating-linear-gradient(
        to bottom,
        #000 0 1px,
        transparent 1px 24px
      ),
      repeating-linear-gradient(
        to right,
        #000 0 4px,
        transparent 4px 8px
      );
    -webkit-mask-composite: source-in;
  }

  .timeline-grid::after {
    mask-image:
      repeating-linear-gradient(
        to right,
        #000 0 1px,
        transparent 1px 24px
      ),
      repeating-linear-gradient(
        to bottom,
        #000 0 4px,
        transparent 4px 8px
      );
    mask-composite: intersect;
    -webkit-mask-image:
      repeating-linear-gradient(
        to right,
        #000 0 1px,
        transparent 1px 24px
      ),
      repeating-linear-gradient(
        to bottom,
        #000 0 4px,
        transparent 4px 8px
      );
    -webkit-mask-composite: source-in;
  }

  :global(html[data-theme="dark"]) .timeline-grid::before,
  :global(html[data-theme="dark"]) .timeline-grid::after {
    background-color: color-mix(in oklch, var(--muted) 16%, transparent);
  }

  .timeline-band {
    scrollbar-width: none;
  }

  .timeline-band::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initTimeline() {
    const section = document.querySelector<HTMLElement>("[data-timeline]");
    const sticky = section?.querySelector<HTMLElement>("[data-timeline-sticky]");
    const track = section?.querySelector<HTMLElement>("[data-timeline-track]");
    if (!section || !sticky || !track) return;

    const items = [...track.querySelectorAll<HTMLElement>("[data-timeline-item]")];
    const axis = track.querySelector<HTMLElement>("[data-timeline-axis]");
    const arrow = track.querySelector<HTMLElement>("[data-timeline-arrow]");
    const minDotGap = 80;
    const sameSideGap = 40;

    const edgePad = () => Math.max(24, (window.innerWidth - 672) / 2 + 24);

    const pack = () => {
      const startPad = edgePad();
      let aboveEnd = startPad;
      let belowEnd = startPad;
      let lastDot = startPad - minDotGap;
      let maxRight = startPad;

      for (const item of items) {
        const label = item.querySelector<HTMLElement>("[data-timeline-label]");
        const labelW = label?.offsetWidth ?? 0;
        const below = item.dataset.side === "below";
        const x = Math.max(below ? belowEnd : aboveEnd, lastDot + minDotGap);
        item.style.left = `${x}px`;
        lastDot = x;
        const end = x + 18 + labelW + sameSideGap;
        if (below) belowEnd = end;
        else aboveEnd = end;
        maxRight = Math.max(maxRight, x + 18 + labelW);
      }

      const arrowLeft = maxRight + 16;
      if (axis) axis.style.width = `${arrowLeft}px`;
      if (arrow) arrow.style.left = `${arrowLeft}px`;
      track.style.width = `${arrowLeft + 12 + edgePad()}px`;
    };

    const overflow = () => Math.max(0, track.scrollWidth - window.innerWidth);

    const peek = () => {
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      return Math.round(rem * 5);
    };

    const pinHeight = () => Math.max(360, window.innerHeight - peek() * 2);

    const layout = () => {
      pack();
      sticky.scrollLeft = 0;
      const extra = overflow();
      const top = peek();
      const height = pinHeight();
      if (extra <= 1) {
        section.style.height = "";
        sticky.style.top = "";
        sticky.style.height = "";
        sticky.classList.remove("sticky");
        track.style.transform = "";
        return;
      }
      sticky.classList.add("sticky");
      sticky.style.top = `${top}px`;
      sticky.style.height = `${height}px`;
      section.style.height = `${height + extra}px`;
    };

    const update = () => {
      const extra = overflow();
      if (extra <= 1) return;
      const top = peek();
      const scrolled = Math.min(Math.max(top - section.getBoundingClientRect().top, 0), extra);
      const progress = extra > 0 ? scrolled / extra : 0;
      track.style.transform = `translate3d(${-extra * progress}px, 0, 0)`;
    };

    const refresh = () => {
      layout();
      update();
    };

    const prior = (window as Window & { __timelineAbort?: AbortController }).__timelineAbort;
    prior?.abort();
    const ac = new AbortController();
    (window as Window & { __timelineAbort?: AbortController }).__timelineAbort = ac;

    refresh();
    window.addEventListener("scroll", update, { passive: true, signal: ac.signal });
    window.addEventListener("resize", refresh, { signal: ac.signal });
    document.fonts?.ready.then(refresh);
  }

  initTimeline();
</script>
